<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- This file is not a robot in and of itself, it just contains some useful tags that could be included in any robot -->
  <material name="base_blue">
    <color rgba="0 0 0.50196 1"/>
  </material>

  <material name="wheel_black">
    <color rgba="0 0 0 1"/>
  </material>

  <material name="light_grey">
    <color rgba="0.79216 0.81961 0.93333 1"/>
  </material>

  <gazebo reference="base_link">
    <material>Gazebo/SkyBlue</material>
  </gazebo>

<gazebo reference="left_wheel">
  <material>Gazebo/Black</material>
  <mu1>1.0</mu1>    <!-- keep forward traction high -->
  <mu2>0.15</mu2> <!-- let the wheel scrub sideways during turns -->
  <kp>1e6</kp>
  <kd>100.0</kd>
  <fdir1>1 0 0</fdir1>  <!-- pin the friction direction explicitly -->
</gazebo>

<gazebo reference="right_wheel">
  <material>Gazebo/Black</material>
  <mu1>1.0</mu1>
  <mu2>0.15</mu2>
  <kp>1e6</kp>
  <kd>100.0</kd>
  <fdir1>1 0 0</fdir1>
</gazebo>

  <gazebo reference="castor">
    <material>Gazebo/Grey</material>
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
  </gazebo>

  <gazebo reference="imu">
    <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference="lidar">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="camera">
    <material>Gazebo/Grey</material>
  </gazebo>

</robot>