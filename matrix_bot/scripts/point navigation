#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from rclpy.action import ActionClient
from action_msgs.msg import GoalStatus
from geometry_msgs.msg import PoseStamped
from nav2_msgs.action import NavigateToPose
from std_srvs.srv import SetBool

class PatrolBotService(Node):
    def __init__(self):
        super().__init__('patrol_bot_service')
        
        # 1. Create a ROS 2 Service to Start (True) or Stop (False) the loop
        self.srv = self.create_service(SetBool, 'toggle_patrol', self.toggle_patrol_callback)
        
        # 2. Create an Action Client to interface with Nav2
        self.nav_client = ActionClient(self, NavigateToPose, 'navigate_to_pose')
        
        # 3. Define your 4 coordinates (X, Y) inside the simulation/map
        self.waypoints = [
            (1.5, 1.5),   # Point 1
            (3.5, 1.5),   # Point 2
            (3.5, 3.5),   # Point 3
            (1.5, 3.5)    # Point 4
        ]
        
        self.current_index = 0
        self.is_patrolling = False
        self.goal_handle = None

        self.get_logger().info("Patrol Service Server is ready. Call /toggle_patrol to start.")

    def toggle_patrol_callback(self, request, response):
        """ Handles the incoming ROS 2 Service requests """
        if request.data:  # If True, start patrolling
            if not self.is_patrolling:
                self.is_patrolling = True
                self.get_logger().info("Patrol activated! Moving to the first point...")
                self.send_next_goal()
                response.success = True
                response.message = "Patrol started continuously."
            else:
                response.success = True
                response.message = "Patrol is already running."
        else:            # If False, stop patrolling
            if self.is_patrolling:
                self.is_patrolling = False
                self.get_logger().info("Patrol deactivated! Canceling current goal...")
                if self.goal_handle is not None:
                    self.goal_handle.cancel_goal_async()
                response.success = True
                response.message = "Patrol stopped successfully."
            else:
                response.success = True
                response.message = "Patrol was not active anyway."
        
        return response

    def send_next_goal(self):
        """ Sends the next coordinate to Nav2 stack """
        if not self.is_patrolling:
            return

        # Wait for the navigation action server to be online
        if not self.nav_client.wait_for_action_server(timeout_sec=2.0):
            self.get_logger().error("Nav2 '/navigate_to_pose' action server not available!")
            self.is_patrolling = False
            return

        x, y = self.waypoints[self.current_index]
        self.get_logger().info(f"Navigating to Point {self.current_index + 1}: X={x}, Y={y}")

        # Construct the navigation goal
        goal_msg = NavigateToPose.Goal()
        goal_msg.pose.header.frame_id = 'map'
        goal_msg.pose.header.stamp = self.get_clock().now().to_msg()
        goal_msg.pose.pose.position.x = x
        goal_msg.pose.pose.position.y = y
        goal_msg.pose.pose.orientation.w = 1.0  # Facing default orientation

        # Send goal asynchronously
        send_goal_future = self.nav_client.send_goal_async(goal_msg)
        send_goal_future.add_done_callback(self.goal_response_callback)

    def goal_response_callback(self, future):
        """ Confirms whether Nav2 accepted or rejected the point """
        self.goal_handle = future.result()
        if not self.goal_handle.accepted:
            self.get_logger().error("Goal was rejected by Nav2.")
            return

        # Listen for the robot arriving at the destination
        get_result_future = self.goal_handle.get_result_async()
        get_result_future.add_done_callback(self.get_result_callback)

    def get_result_callback(self, future):
        """ Triggers when the bot reaches a destination or fails """
        result = future.result()
        
        if result.status == GoalStatus.STATUS_SUCCEEDED:
            self.get_logger().info(f"Arrived at Point {self.current_index + 1} successfully!")
        else:
            self.get_logger().warn(f"Failed to reach Point {self.current_index + 1} (Status code: {result.status})")

        # If patrol is still enabled, increment index to loop back around continuously
        if self.is_patrolling:
            self.current_index = (self.current_index + 1) % len(self.waypoints)
            self.send_next_goal()

def main(args=None):
    rclpy.init(args=args)
    node = PatrolBotService()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()